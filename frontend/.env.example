# Public browser configuration. Do not put API keys or database credentials here.
# Local development backend in this project normally runs on port 18000.
# Use the origin only: no trailing slash, /api or /api/v1.
# Copy to frontend/.env.local for local settings; never commit that file.
NEXT_PUBLIC_API_URL=http://127.0.0.1:18000
NEXT_PUBLIC_API_ROOT=http://127.0.0.1:18000
