# InvestScope local/Docker configuration.
# Copy this file to .env and replace only values required for your environment.
# All values below are placeholders or safe development defaults.

# Required for Docker Compose PostgreSQL.
POSTGRES_DB=investscope
POSTGRES_USER=investscope
POSTGRES_PASSWORD=replace-with-local-password

# Required for the backend. The host `db` is the Docker Compose service name.
# When running the backend directly on the host, override `db` with `localhost`.
INVESTSCOPE_DATABASE_URL=postgresql+psycopg://investscope:replace-with-local-password@db:5432/investscope

# Optional backend identity and routing settings.
INVESTSCOPE_APP_NAME=InvestScope API
INVESTSCOPE_ENVIRONMENT=development
INVESTSCOPE_API_PREFIX=/api/v1
INVESTSCOPE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3200"]

# Browser-visible API origins. These values must never contain credentials.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_ROOT=http://127.0.0.1:8000

# Market-data provider. `demo` requires no external credential.
INVESTSCOPE_MARKET_DATA_PROVIDER=demo
INVESTSCOPE_MARKET_DATA_TIMEOUT_SECONDS=10
INVESTSCOPE_MARKET_SYNC_MAX_DAYS=366
INVESTSCOPE_MARKET_DATA_STALE_AFTER_HOURS=36
INVESTSCOPE_MARKET_DAILY_SESSION_CLOSE_HOUR_UTC=21

# Optional Alpha Vantage read-only market-data access.
INVESTSCOPE_ALPHA_VANTAGE_API_KEY=
INVESTSCOPE_ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
INVESTSCOPE_ALPHA_VANTAGE_DAILY_LIMIT=25
INVESTSCOPE_ALPHA_VANTAGE_DAILY_RESERVE=1
INVESTSCOPE_ALPHA_VANTAGE_MIN_INTERVAL_SECONDS=1.5
INVESTSCOPE_ALPHA_VANTAGE_RATE_LIMIT_COOLDOWN_SECONDS=60

# SEC EDGAR access. Replace the example contact only for local live SEC access.
# Offline JSON import does not require SEC network access.
INVESTSCOPE_SEC_USER_AGENT=InvestScope Portfolio Demo contact@example.com
INVESTSCOPE_SEC_MAX_REQUESTS_PER_SECOND=1
INVESTSCOPE_SEC_CACHE_TTL_HOURS=24
INVESTSCOPE_SEC_TICKER_CACHE_TTL_HOURS=168
INVESTSCOPE_SEC_REQUEST_TIMEOUT_SECONDS=30
INVESTSCOPE_SEC_IMPORT_MAX_FILE_MB=100
